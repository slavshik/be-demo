        {
          "name": "Non-numeric limit → 400",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leaderboard?limit=abc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leaderboard"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "abc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"returns an error message\", () => pm.expect(pm.response.json().error).to.be.a(\"string\").and.not.empty);"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
