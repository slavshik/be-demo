{
  "info": {
    "name": "Mini Game Backend API",
    "description": "Requests and tests for every endpoint. Run the whole collection in order: \"Register player\" creates a fresh username that later requests reuse, so the collection works against a database that already has data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "usernameUpper",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"status is ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Web UI",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": []
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"serves HTML\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/html\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Players",
      "item": [
        {
          "name": "Register player",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/players",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "players"
              ]
            },
            "description": "Generates a unique username and stores it in the `username` and `usernameUpper` collection variables.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const name = \"player_\" + Date.now();",
                  "pm.collectionVariables.set(\"username\", name);",
                  "pm.collectionVariables.set(\"usernameUpper\", name.toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"returns the username\", () => pm.expect(body.username).to.eql(pm.collectionVariables.get(\"username\")));",
                  "pm.test(\"returns a UTC created_at\", () => pm.expect(body.created_at).to.match(/Z$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate username, different case → 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/players",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "players"
              ]
            },
            "description": "Same name in upper case: uniqueness ignores case.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usernameUpper}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"returns an error message\", () => pm.expect(pm.response.json().error).to.be.a(\"string\").and.not.empty);"
                ]
              }
            }
          ]
        },
