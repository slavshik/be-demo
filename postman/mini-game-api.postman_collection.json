    {
      "name": "Leaderboard",
      "item": [
        {
          "name": "Top 10 (default limit)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leaderboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leaderboard"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const board = pm.response.json().leaderboard;",
                  "pm.test(\"is an array of at most 10\", () => pm.expect(board).to.be.an(\"array\").with.length.at.most(10));",
                  "pm.test(\"total counts ranked players\", () => pm.expect(pm.response.json().total).to.be.a(\"number\").and.at.least(board.length));",
                  "pm.test(\"sorted by score, highest first\", () => {",
                  "  for (let i = 1; i < board.length; i++) pm.expect(board[i - 1].score).to.be.at.least(board[i].score);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Top 100, includes this run's player",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leaderboard?limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leaderboard"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const board = pm.response.json().leaderboard;",
                  "const me = board.filter((e) => e.username === pm.collectionVariables.get(\"username\"));",
                  "pm.test(\"player appears once, with their best score\", () => {",
                  "  pm.expect(me).to.have.length(1);",
                  "  pm.expect(me[0].score).to.eql(1500);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Limit 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leaderboard?limit=1",
