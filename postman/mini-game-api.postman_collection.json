                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"one entry\", () => pm.expect(pm.response.json().leaderboard).to.have.length(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Second page (offset)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leaderboard?limit=1&offset=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leaderboard"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "1"
                },
                {
                  "key": "offset",
                  "value": "1"
                }
              ]
            },
            "description": "Page 2 at one entry per page. Compares against the top 2 to check that offset skips exactly one row."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.sendRequest(pm.collectionVariables.get(\"baseUrl\") + \"/leaderboard?limit=2\", (err, res) => {",
                  "  const top2 = res.json().leaderboard;",
                  "  pm.test(\"matches rank 2 of the full board\", () => {",
                  "    if (top2.length < 2) return pm.expect(page.leaderboard).to.have.length(0);",
                  "    pm.expect(page.leaderboard).to.eql([top2[1]]);",
                  "  });",
                  "  pm.test(\"total is the same on every page\", () => pm.expect(page.total).to.eql(res.json().total));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Offset past the end → empty page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leaderboard?offset=1000000",
